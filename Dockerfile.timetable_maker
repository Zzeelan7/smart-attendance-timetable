# Use Python 3.11 slim image
FROM python:3.11-slim

# Install system dependencies (minimal for timetable maker)
RUN apt-get update && apt-get install -y \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app/timetable_maker

# Copy requirements
COPY timetable_maker/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY timetable_maker/ .

# Create output directory
RUN mkdir -p output

# Expose Flask port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5001/')" || exit 1

# Run the Flask app
CMD ["python", "app.py"]
